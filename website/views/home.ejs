<%- include('partials/head') %>

<section class="hero section-shell">
  <div class="hero-copy">
    <span class="eyebrow">Record. Capture. Relive.</span>
    <h1>Capturing the moments that matter most.</h1>
    <p class="lede">PLACEHOLDER: Replace this hero copy with the verified ClipIt Button value proposition and audience.</p>
    <div class="button-row">
      <a class="button" href="/products">Shop ClipIt Products</a>
      <a class="text-link" href="#companion-app">Explore the companion app <span aria-hidden="true">→</span></a>
    </div>
    <p class="placeholder-notice"><strong>Content note:</strong> Product names, pricing, artwork, and claims on this starter site are placeholders.</p>
  </div>
  <div class="hero-visual" aria-label="Placeholder product art">
    <img src="/images/hero-placeholder.svg" alt="Abstract placeholder illustration for the ClipIt Button" width="900" height="820">
  </div>
</section>

<section class="marquee" aria-label="Placeholder product principles">
  <span>Connects via Bluetooth</span><i></i><span>Clip your highlights</span><i></i><span>Made for athletes by athletes</span>
</section>

<section class="section-shell product-section">
  <div class="section-heading">
    <div>
      <span class="eyebrow">The collection</span>
      <h2>Start with the button. Add what fits.</h2>
    </div>
    <a class="text-link" href="/products">View all products <span aria-hidden="true">→</span></a>
  </div>
  <div class="product-grid">
    <% featuredProducts.forEach((product) => { %>
      <%- include('partials/product-card', { product, reviewSummary: reviewSummaries[product.id] }) %>
    <% }) %>
  </div>
</section>

<section class="story-band">
  <div class="section-shell story-grid">
    <div class="story-number">01</div>
    <div>
      <span class="eyebrow">PLACEHOLDER: How it works</span>
      <h2>Add one clear, verified explanation of the product experience here.</h2>
    </div>
    <p>PLACEHOLDER: Explain a simple three-step flow after the product behavior is confirmed. Avoid unverified compatibility, range, battery, or performance claims.</p>
  </div>
</section>

<section class="testimonials-section" aria-labelledby="testimonials-heading">
  <div class="section-shell testimonials-heading">
    <div>
      <span class="eyebrow">Customer stories</span>
      <h2 id="testimonials-heading">What people are saying.</h2>
    </div>
    <p>PLACEHOLDER: Replace these cards only with accurate customer quotes that you have permission to publish.</p>
  </div>
  <div class="testimonial-viewport" data-testimonial-viewport tabindex="0" aria-label="Customer testimonials. Drag or scroll horizontally to browse.">
    <div class="testimonial-track" data-testimonial-track>
      <div class="testimonial-set">
        <% testimonials.forEach((review) => { %><%- include('partials/review-card', { review }) %><% }) %>
      </div>
      <div class="testimonial-set" aria-hidden="true">
        <% testimonials.forEach((review) => { %><%- include('partials/review-card', { review }) %><% }) %>
      </div>
    </div>
  </div>
</section>

<section class="app-promo section-shell" id="companion-app">
  <div class="app-art">
    <img src="/images/app-placeholder.svg" alt="Placeholder screens for the ClipIt companion app" width="780" height="700">
  </div>
  <div class="app-copy">
    <span class="eyebrow">Download the ClipIt app</span>
    <h2>Your product and app, designed to work together.</h2>
    <p>PLACEHOLDER: Add approved details about the companion app, supported platforms, privacy practices, and required account or connectivity.</p>
    <div class="store-buttons">
      <a class="store-button" href="<%= appStoreUrl %>" rel="noopener">App Store <small>placeholder link</small></a>
      <a class="store-button" href="<%= playStoreUrl %>" rel="noopener">Google Play <small>placeholder link</small></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
