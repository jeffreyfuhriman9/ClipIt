<%- include('partials/head') %>

<section class="page-intro section-shell">
  <span class="eyebrow">Shop ClipIt</span>
  <h1>Stop watching the game through your phone, it's time to ClipIt!.</h1>
</section>

<section class="section-shell product-section product-listing">
  <div class="product-grid">
    <% products.forEach((product) => { %>
      <%- include('partials/product-card', { product, reviewSummary: reviewSummaries[product.id] }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
