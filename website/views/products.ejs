<%- include('partials/head') %>

<section class="page-intro section-shell">
  <span class="eyebrow">Shop ClipIt</span>
  <h1>Products built around your everyday moments.</h1>
  <p>Every listing below is placeholder content. Edit the single catalog file before accepting real orders.</p>
</section>

<section class="section-shell product-section product-listing">
  <div class="product-grid">
    <% products.forEach((product) => { %>
      <%- include('partials/product-card', { product, reviewSummary: reviewSummaries[product.id] }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
