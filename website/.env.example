# Required for checkout. Use a Stripe test secret locally (never commit .env).
STRIPE_SECRET_KEY=sk_test_replace_me
# Create with `stripe listen --forward-to localhost:3000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Browser-visible canonical origin. No trailing slash.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# REVIEW BEFORE LAUNCH: countries where physical orders may ship (ISO alpha-2).
SHIPPING_COUNTRIES=US
# REVIEW BEFORE LAUNCH: enable only after configuring Stripe Tax.
STRIPE_AUTOMATIC_TAX=false

# Placeholder companion-app destinations.
APP_STORE_URL=https://example.com/replace-with-app-store-url
PLAY_STORE_URL=https://example.com/replace-with-play-store-url

# Optional How It Works video. Paste a standard YouTube watch, share, Shorts, or embed URL.
# HOW_IT_WORKS_YOUTUBE_URL=https://www.youtube.com/watch?v=replace_me

# Contact-form delivery. Configure these only when you are ready to receive live messages.
# Your email provider supplies the host, port, username, password/app password, and sender.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=support@clipitbutton.com

# Private fulfillment dashboard. Requires a PostgreSQL database. Use a unique,
# randomly generated password of at least 24 characters; never put it in source control.
# ORDER_DATABASE_URL=postgresql://...
# FULFILLMENT_ADMIN_PASSWORD=replace_with_a_long_random_password

# Verified reviews. Requires both a PostgreSQL database and S3-compatible object storage.
DATABASE_URL=
REVIEW_MEDIA_BUCKET=
REVIEW_MEDIA_REGION=auto
REVIEW_MEDIA_ENDPOINT=
REVIEW_MEDIA_ACCESS_KEY_ID=
REVIEW_MEDIA_SECRET_ACCESS_KEY=
# Public CDN/base URL for media, no trailing slash (for example https://media.your-domain.com).
REVIEW_MEDIA_PUBLIC_BASE_URL=
